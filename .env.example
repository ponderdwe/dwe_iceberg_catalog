# Copy to .env and fill in values, then: docker-compose up -d

# Nessie version store database
# Local dev: overridden by docker-compose.override.yml (local postgres auto-started)
# Production: set to your managed PostgreSQL instance
NESSIE_DB_URL=jdbc:postgresql://postgres:5432/nessie
NESSIE_DB_USER=nessie
NESSIE_DB_PASS=nessie
